# Server
PORT=3000
NODE_ENV=production
DATABASE_PATH=./data/alerts.db
PRICE_POLL_INTERVAL_MS=5000

# Telegram (required for alerts)
TELEGRAM_BOT_TOKEN=1234567890:AAH-example-token-from-BotFather
TELEGRAM_CHAT_ID=123456789

# Price Provider - FREE default is polling with xaus.com (no API key)
# Options: mock | exness | polling
PRICE_PROVIDER=polling
# For exness: set the WebSocket or REST endpoint if you have Exness API access
EXNESS_API_URL=
EXNESS_API_KEY=
# For generic polling provider - 100% FREE, no key needed
# xaus.com: https://xaus.com/api/v1/spot (default, free)
# alt: https://www.chartgoldprice.com/api/data
# alt: https://api.gold-api.com/price/XAU
POLLING_PRICE_URL=https://xaus.com/api/v1/spot
POLLING_API_KEY=

# Frontend API URL (for Vite build)
# VITE_API_URL=http://localhost:3000

# Timezone display (server stores UTC, displays IST)
DISPLAY_TIMEZONE=Asia/Kolkata
